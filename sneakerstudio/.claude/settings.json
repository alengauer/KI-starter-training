{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run typecheck)",
      "Bash(npx vitest run *)"
    ],
    "ask": [
      "Edit(package.json)",
      "Edit(playwright.config.ts)",
      "Bash(npm install *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Edit(e2e/**)",
      "Edit(**/*.spec.ts)",
      "Edit(**/*.test.ts)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-tests.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-tests-unchanged.sh"
          }
        ]
      }
    ]
  }
}
